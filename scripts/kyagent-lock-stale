#!/usr/bin/env python3
"""Inspect/remove stale lock files under runtime roots."""
from __future__ import annotations

import argparse
import json
import os
import re
import stat
import subprocess
import sys

ALLOWED_ROOTS = ("/tmp", "/var/tmp", "/run", "/var/run")
PID_RE = re.compile(r"^(?:pid=)?([1-9][0-9]*)\s*$")


def die(msg: str, code: int = 2) -> None:
    sys.stderr.write(f"kyagent-lock-stale: {msg}\n")
    raise SystemExit(code)


def within_allowed(path: str) -> bool:
    return any(path.startswith(root + os.sep) for root in ALLOWED_ROOTS)


def normalize(raw: str) -> str:
    if not raw.startswith("/"):
        die(f"必须是绝对路径: {raw!r}")
    if "\0" in raw:
        die("路径含 NUL 字节")
    real = os.path.realpath(raw)
    if not within_allowed(real):
        die(f"解析后路径越界，仅允许 {', '.join(ALLOWED_ROOTS)} 下: {real}")
    return real


def read_pid_from_fd(fd: int) -> int:
    os.lseek(fd, 0, os.SEEK_SET)
    data = os.read(fd, 256)
    try:
        text = data.decode("ascii")
    except UnicodeDecodeError:
        die("lock 内容不是 ASCII PID")
    first_line = text.split("\n", 1)[0].split("\r", 1)[0]
    match = PID_RE.fullmatch(first_line)
    if not match:
        die("lock 首行必须是纯 PID 或 pid=<num>")
    pid = int(match.group(1))
    if pid < 2:
        die("PID 小于 2，拒绝处理")
    return pid


def open_lock(path: str) -> tuple[int, os.stat_result, str, int]:
    normalize(path)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        die(f"打开失败（末端是符号链接、目录或不存在）: {exc}")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            die("目标不是普通文件 lock，拒绝处理")
        try:
            resolved = os.readlink(f"/proc/self/fd/{fd}")
        except OSError:
            resolved = os.path.realpath(path)
        if not within_allowed(resolved):
            die(f"打开后真实路径越界，仅允许 {', '.join(ALLOWED_ROOTS)} 下: {resolved}")
        pid = read_pid_from_fd(fd)
        return fd, st, resolved, pid
    except Exception:
        os.close(fd)
        raise


def pid_exists(pid: int) -> bool:
    return os.path.exists(f"/proc/{pid}")


def run_tool(argv: list[str]) -> str:
    try:
        result = subprocess.run(
            argv,
            check=False,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=5,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    if result.returncode != 0:
        return ""
    return (result.stdout or "") + (result.stderr or "")


def has_live_holder(path: str) -> tuple[bool, list[str]]:
    evidence: list[str] = []
    for argv in (["lsof", "-nP", "--", path], ["fuser", "-v", "--", path]):
        out = run_tool(argv)
        for line in out.splitlines():
            if line.strip():
                evidence.append(line)
        if out.strip():
            return True, evidence
    proc_root = "/proc"
    try:
        pids = [name for name in os.listdir(proc_root) if name.isdigit()]
    except OSError:
        return False, evidence
    for pid in pids:
        fd_dir = os.path.join(proc_root, pid, "fd")
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd_name in fds:
            try:
                target = os.readlink(os.path.join(fd_dir, fd_name))
            except OSError:
                continue
            if target == path:
                evidence.append(f"pid={pid} fd={fd_name} path={target}")
                return True, evidence
    return False, evidence


def inspect(path: str) -> int:
    fd, st, resolved, pid = open_lock(path)
    os.close(fd)
    live_pid = pid_exists(pid)
    held, evidence = has_live_holder(resolved)
    payload = {
        "path": resolved,
        "dev": st.st_dev,
        "inode": st.st_ino,
        "pid": pid,
        "pid_exists": live_pid,
        "live_holder_detected": held,
        "stale": (not live_pid) and (not held),
        "holder_evidence": evidence[:20],
    }
    print(json.dumps(payload, ensure_ascii=False, sort_keys=True))
    return 0


def remove(path: str, expected_pid: int | None) -> int:
    fd, st, resolved, pid = open_lock(path)
    os.close(fd)
    if expected_pid is not None and pid != expected_pid:
        die(f"PID 与 expected_pid 不一致: actual={pid} expected={expected_pid}")
    if pid_exists(pid):
        die(f"PID 仍存在，拒绝删除 live lock: {pid}")
    held, evidence = has_live_holder(resolved)
    if held:
        die("lsof/fuser 发现 live 持有者，拒绝删除: " + " | ".join(evidence[:3]))

    fd2, st2, resolved2, pid2 = open_lock(path)
    try:
        if (st2.st_dev, st2.st_ino) != (st.st_dev, st.st_ino) or resolved2 != resolved:
            die("删除前目标 inode 已变化，拒绝删除")
        if pid2 != pid:
            die("删除前 PID 内容已变化，拒绝删除")
        try:
            current = os.lstat(path)
        except OSError as exc:
            die(f"删除前复检失败: {exc}")
        if stat.S_ISLNK(current.st_mode) or not stat.S_ISREG(current.st_mode):
            die("删除前类型复检失败：目标不再是普通文件")
        if (current.st_dev, current.st_ino) != (st.st_dev, st.st_ino):
            die("删除前目标 inode 已变化，拒绝删除")
        os.unlink(path)
        if os.path.lexists(path):
            die("删除后复检失败：路径仍存在", code=3)
        print(f"removed stale lock: {resolved} pid={pid}")
        return 0
    finally:
        os.close(fd2)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="kyagent-lock-stale")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p_inspect = sub.add_parser("inspect")
    p_inspect.add_argument("path")
    p_remove = sub.add_parser("remove")
    p_remove.add_argument("path")
    p_remove.add_argument("--expected-pid", type=int)
    args = parser.parse_args(argv[1:])

    if args.cmd == "inspect":
        return inspect(args.path)
    return remove(args.path, args.expected_pid)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
