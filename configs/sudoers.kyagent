# /etc/sudoers.d/kyagent
#
# 安装：
#   sudo bash scripts/setup-sudoers.sh
# 手工安装前必须先确认 sudo >= 1.9.10，并校验源文件：
#   sudo visudo -cf configs/sudoers.kyagent
#   sudo install -m 0440 configs/sudoers.kyagent /etc/sudoers.d/kyagent
#
# 设计原则（与赛题"最小权限代理执行"对应）：
#   1) 这里只授权实际需要 root 的命令；普通只读命令由 kyagent 直接执行
#   2) 固定参数命令逐条列出，不使用跨空白匹配的 glob
#   3) 动态参数命令使用 sudo >= 1.9.10 的锚定参数正则，限制为单个安全参数
#   4) 不允许 sh / bash / python / perl / awk / sed / find -exec 等"shell-equivalent"
#
# 用户 kyagent 必须存在。建议：
#   sudo useradd -r -s /usr/sbin/nologin kyagent
#   sudo usermod -aG systemd-journal kyagent

# ---- 只读 root 查询：网络 / 日志 / 安全 --------------------------------
Cmnd_Alias KY_ROOT_OBSERVE = \
    /usr/sbin/iptables -L -n -v --line-numbers, \
    /usr/sbin/nft list ruleset, \
    /usr/sbin/aureport --summary, /sbin/aureport --summary, \
    /usr/sbin/aa-status, /sbin/aa-status, \
    /usr/bin/aide --check --config /etc/aide.conf, \
    /usr/sbin/aide --check --config /etc/aide.conf, \
    /usr/sbin/dmidecode -s system-product-name, \
    /usr/sbin/dmidecode -s system-manufacturer, \
    /sbin/dmidecode -s system-product-name, \
    /sbin/dmidecode -s system-manufacturer

# ---- 只读 root 查询：受限动态参数 ---------------------------------------
# 参数正则必须同时以 ^ 开头、以 $ 结尾；否则 sudo 会退回跨空白 glob 语义。
Cmnd_Alias KY_ROOT_REGEX_OBSERVE = \
    /usr/bin/smartctl ^-H -A -- /dev/sd[a-z][0-9]*$, \
    /usr/bin/smartctl ^-H -A -- /dev/nvme[0-9]+n[0-9]+(p[0-9]+)?$, \
    /usr/bin/crontab ^-l -u [a-z_][a-z0-9_-]{0,31}$

# ---- 只读 root 查询：sudoers 自审计 -------------------------------------
# 工具层支持任意合法用户名，但 sudoers 只授权审计运行账户自身。审计其他账户需人工执行。
Cmnd_Alias KY_SELF_AUDIT = \
    /usr/bin/sudo -l -U kyagent

# ---- 服务变更（高风险，需要 confirm，由 Guardrail 拦） ------------------
# 单个 unit 参数限定为常见 systemd 名称字符；不允许额外 argv 或以 '-' 开头的选项。
Cmnd_Alias KY_SVC_MUTATE = \
    /usr/bin/systemctl ^restart [A-Za-z0-9@._+:][-A-Za-z0-9@._+:]*$, \
    /usr/bin/systemctl ^reload [A-Za-z0-9@._+:][-A-Za-z0-9@._+:]*$, \
    !/usr/bin/systemctl ^(restart|reload) (systemd-logind|systemd-journald|systemd-udevd|dbus|polkit)([.]service)?$

# ---- 授权 --------------------------------------------------------------
kyagent  ALL=(root)  NOPASSWD: KY_ROOT_OBSERVE, KY_ROOT_REGEX_OBSERVE, KY_SELF_AUDIT
kyagent  ALL=(root)  NOPASSWD: KY_SVC_MUTATE

Defaults:kyagent  !visiblepw, !env_keep, lecture=never, requiretty=false, \
                  log_input, log_output, iolog_dir=/var/log/sudo-io/%{user}
